# 本地真实打印机；访问码仅填写在未共享的 .env 中
PRINTER_MODE=real
PRINTER_HOST=172.20.10.7
BAMBU_SERIAL=
BAMBU_TOKEN=
BAMBU_MODEL=x2d
BAMBU_MQTT_PORT=8883
BAMBU_FTPS_PORT=990
BAMBU_FTPS_DIR=cache
BAMBU_BED_TYPE=textured_plate
BAMBU_NOZZLE_DIAMETER=0.4
BAMBU_CONFIRMATION_TIMEOUT_MS=300000
CHARM_PROJECT_3MF=./data/九辰灯符-X2D-蓝白PLA.3mf

# macOS：填写实际 Bambu Studio 可执行文件和官方网络插件路径
SLICER_TYPE=bambustudio
SLICER_PATH=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio
BAMBU_NATIVE_PLUGIN=/Applications/BambuStudio.app/Contents/Frameworks/libbambu_networking.dylib
BAMBU_NATIVE_CONFIG_DIR=./data/native
BAMBU_NATIVE_CERT_DIR=/Applications/BambuStudio.app/Contents/Resources/cert
# 自动重新切片时需要：两个官方 X2D 0.4mm PLA 配置，以分号分隔
CHARM_LOAD_FILAMENTS=

# 可选：不配置时使用确定性的离线演示运势
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Cloudflare 公网入口（使用打印机 SN / 访问码验证，无独立站点口令）
PUBLIC_ORIGIN=
